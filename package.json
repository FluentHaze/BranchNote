{
  "name": "branchnote",
  "version": "0.2.5",
  "private": true,
  "description": "离线分支发布记录工具",
  "author": "BranchNote",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "assets:dmg": "electron scripts/create-dmg-background.cjs",
    "test:update-transport": "electron scripts/test-update-fetch.cjs",
    "test:update-ui": "electron scripts/test-update-ui.cjs",
    "test:tray": "electron scripts/test-tray.cjs",
    "start": "npm run build && electron .",
    "test": "tsc -p tsconfig.electron.json && tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.cjs",
    "test:ui": "node scripts/ui-test.cjs",
    "test:stage": "node scripts/ui-stage-test.cjs",
    "pack": "node scripts/pack.mjs all",
    "pack:win": "node scripts/pack.mjs win",
    "pack:mac": "node scripts/pack.mjs mac",
    "gitlab:demo": "node scripts/gitlab-demo.mjs",
    "test:mr-ui": "electron scripts/mr-ui-test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.branchnote.desktop",
    "productName": "BranchNote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/prepare-mac-dmg.mjs",
    "afterSign": "scripts/verify-mac-signature.mjs",
    "dmg": {
      "title": "${productName}",
      "background": "public/dmg/background.png",
      "iconSize": 96,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 255,
          "y": 185,
          "type": "file"
        },
        {
          "x": 545,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 400,
          "y": 490,
          "type": "file",
          "path": "release/.dmg-assets/打开隐私与安全性.inetloc"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "FluentHaze",
      "repo": "BranchNote"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
