---
import { languageNames, languagePath, locales, withBase, type Copy, type Locale } from "../i18n";
import SeoHead from "../components/seo/SeoHead.astro";
import Header from "../components/Header.astro";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/demo.css";
import "../styles/site.css";
import "../styles/select.css";
import "../styles/preview.css";
import "../styles/local-fonts.css";
interface Props { copy: Copy; locale: Locale; }
const { copy: c, locale } = Astro.props;
const canonical = new URL(languagePath(locale), Astro.site);
const home = new URL(withBase(""), Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": home + "#website", name: "BranchNote", url: home, inLanguage: [...locales] },
    {
      "@type": "WebPage", "@id": canonical.href + "#webpage", url: canonical.href,
      name: c.seo.title, description: c.seo.description, inLanguage: locale,
      isPartOf: { "@id": home + "#website" }, mainEntity: { "@id": home + "#application" },
    },
    {
      "@type": "SoftwareApplication", "@id": home + "#application", name: "BranchNote",
      applicationCategory: "DeveloperApplication", operatingSystem: "macOS", softwareVersion: "0.2.5",
      description: c.seo.description, url: canonical.href,
      downloadUrl: "https://github.com/FluentHaze/BranchNote/releases/tag/v0.2.5",
      image: new URL(withBase("social/branchnote.png"), Astro.site).href,
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <SeoHead title={c.seo.title} description={c.seo.description} locale={locale}
      canonicalPath={languagePath(locale)} localized structuredData={structuredData} />
  </head>
  <body class="a">
    <a class="skip-link" href="#main-content">{c.inspect}</a>
    <div class="wrap">
      <Header copy={c} locale={locale} />
      <main id="main-content">
        <slot />
      </main>
      <footer>
        <a class="brand" href={languagePath(locale)}>
          <img src={withBase("logo.svg")} alt="" width="28" height="28" loading="lazy" />
          <span>BranchNote</span>
        </a>
        <span>{c.foot}</span>
        <a href="https://github.com/FluentHaze/BranchNote" target="_blank" rel="noopener noreferrer">GitHub</a>
        <noscript>
          {locales.map(value => (
            <a href={languagePath(value)} lang={value}>{languageNames[value]}</a>
          ))}
        </noscript>
      </footer>
    </div>
  </body>
</html>
