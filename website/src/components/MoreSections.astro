---
import { ArrowUpRight } from "lucide-react";
import { withBase, type Copy, type Locale } from "../i18n";
import WorkflowExplorer from "./WorkflowExplorer";
import DownloadButtons from "./DownloadButtons.astro";
interface Props { copy: Copy; locale: Locale; }
const { copy: c, locale } = Astro.props;
const questions = [
  { question: c.q1, answer: c.a1 },
  { question: c.q2, answer: c.a2 },
  { question: c.q3, answer: c.a3 },
];
---

<section id="workflow">
  <h2>{c.work}</h2>
  <WorkflowExplorer locale={locale} client:visible />
  <div class="git-flow-entry">
    <h3>{c.gitFlow.flowTitle}</h3>
    <p>{c.gitFlow.flowIntro}</p>
    <div class="actions">
      <a class="button primary" href={withBase("workflow/git-flow.html")} target="_blank" rel="noopener noreferrer">{c.gitFlow.flowOpen}<ArrowUpRight size={15} strokeWidth={1.5} aria-hidden="true" /></a>
      <a class="button" href={withBase("workflow/")}>{c.gitFlow.flowGuide}</a>
    </div>
    <p class="smallnote">{c.gitFlow.flowLanguage}</p>
  </div>
</section>
<section>
  <div class="privacy">
    <div>
      <h2>{c.privacy}</h2>
      <p>{c.privacytext}</p>
    </div>
    <div class="vault" aria-hidden="true">
      <img src={withBase("logo.svg")} alt="" width="80" height="80" loading="lazy" />
      <code>
        ~/BranchNote/<br />
        branchnote.json<br />
        backup.json
      </code>
    </div>
  </div>
</section>
<section class="download" id="download">
  <h2>{c.get}</h2>
  <p>{c.getintro}</p>
  <DownloadButtons copy={c} />
</section>
<section class="faq">
  <h2>{c.faq}</h2>
  <div>
    {questions.map(({ question, answer }) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </div>
</section>
