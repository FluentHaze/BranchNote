---
import { Content } from "../../../docs/git-workflow.md";
import { withBase, languagePath } from "../i18n";
import "../styles/local-fonts.css";
const title = "BranchNote 推荐 Git 工作流";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="了解 BranchNote 功能分支、临时整合分支和冲突处理分支的职责，以及提交 MR、审核和清理的推荐流程。" />
    <link rel="icon" href={withBase("logo.svg")} type="image/svg+xml" />
    <link rel="canonical" href={new URL(withBase("workflow/"), Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="指南导航"><a href={languagePath("zh-CN")}>← 返回 BranchNote 官网</a><a href={withBase("workflow/git-flow.html")} target="_blank" rel="noopener noreferrer">打开交互流程图 ↗</a></nav>
    <main><Content /></main>

  </body>
</html>
<style>
  :global(html) { color-scheme: light dark; }
  :global(body) { margin: 0; padding: 24px clamp(16px, 4vw, 40px) 64px; font-family: "Branch Sans", system-ui, sans-serif; line-height: 1.85; background: #fafbfc; color: #233047; }
  nav, main { max-width: 840px; margin-inline: auto; }
  nav { display: flex; flex-wrap: wrap; gap: 16px 32px; padding-bottom: 32px; }
  :global(a) { color: #315dba; text-underline-offset: 4px; }
  :global(a:focus-visible) { outline: 3px solid #bd7b00; outline-offset: 4px; }
  :global(h1), :global(h2) { line-height: 1.4; text-wrap: balance; }
  :global(h1) { font-size: clamp(28px, 5vw, 40px); }
  :global(h2) { margin-top: 2em; }
  :global(p), :global(li) { overflow-wrap: anywhere; text-wrap: pretty; }
  :global(pre) { padding: 20px; overflow-x: auto; border-radius: 12px; }
  :global(table) { display: block; overflow-x: auto; border-collapse: collapse; }
  :global(th), :global(td) { padding: 12px 16px; text-align: left; border-bottom: 1px solid #cad3df; min-width: 120px; }
  @media (prefers-color-scheme: dark) {
    :global(body) { color: #d4ddeb; background: #10151f; font-weight: 350; }
    :global(a) { color: #a9c4ff; }
    :global(th), :global(td) { border-color: #303b4c; }
  }
</style>
