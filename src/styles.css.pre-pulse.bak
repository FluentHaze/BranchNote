:root {
  font-size: 14px;
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI",
    "Microsoft YaHei", sans-serif;
  color: #23252a;
  background: #f5f5f7;
  font-synthesis: none;

  --blue: #0879ed;
  --muted: #777b85;
  --line: #e9eaee;
  --green: #27815b;
}
* {
  box-sizing: border-box;
  scrollbar-width: none;
}
*::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
body {
  margin: 0;
}
button,
input,
select,
textarea {
  font: inherit;
}
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  cursor: pointer;
  color: inherit;
  border: 0;
  background: transparent;
  transition:
    background 0.16s,
    color 0.16s,
    box-shadow 0.16s;
}
button:disabled,
.select-trigger:disabled {
  cursor: default;
  opacity: 0.5;
}
button:active:not(:disabled) {
  filter: brightness(0.94);
}
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 3px solid #8cbff8;
  outline-offset: 3px;
}
button,
select {
  -webkit-tap-highlight-color: transparent;
}
input[type="checkbox"] {
  width: 15px;
  height: 15px;
  accent-color: var(--blue);
  cursor: pointer;
}
svg {
  flex-shrink: 0;
}
button svg {
  pointer-events: none;
}
.app-shell {
  display: flex;
  min-height: 100dvh;
}
.sidebar {
  width: 239px;
  flex-shrink: 0;
  background: #f3f4f6;
  border-right: 1px solid #e5e6ea;
  padding: 34px 17px 15px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100dvh;
  overflow-y: auto;
}
.brand {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 0 9px 40px;
}
.brand-icon {
  width: 39px;
  height: 41px;
  border-radius: 12px;
  color: white;
  background: linear-gradient(145deg, #54a4ff, #0071ec);
  display: grid;
  place-items: center;
  box-shadow:
    0 3px 7px #1177d326,
    inset 0 1px 1px #ffffff6b;
}
.brand > span {
  font-size: 20px;
  font-weight: 650;
  letter-spacing: -0.7px;
}
.brand small {
  display: block;
  font-size: 12px;
  font-weight: 400;
  color: #657080;
  letter-spacing: 0.5px;
  margin-top: 5px;
}
.workspace-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #657080;
  font-size: 12px;
  padding: 0 13px;
  margin-bottom: 12px;
}
.workspace-label > span {
  border: 1px solid #d9dce1;
  border-radius: 4px;
  padding: 1px 5px;
  font-size: 12px;
}
.nav-item {
  display: flex;
  width: 100%;
  min-height: 40px;
  padding: 9px 12px;
  gap: 10px;
  border-radius: 7px;
  justify-content: flex-start;
  text-align: left;
  font-size: 12px;
  margin: 3px 0;
  color: #525761;
}
.nav-item:hover {
  background: #e9ebef;
}
.nav-item.active {
  background: #e2ecfa;
  color: #096bd2;
  font-weight: 600;
}
.nav-item > svg {
  color: #657080;
}
.nav-item.active > svg {
  color: #1572df;
}
.count {
  margin-left: auto;
  color: #657080;
  font-size: 12px;
}
.nav-item.active .count {
  color: #1370d7;
}
.nav-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 29px 10px 9px 12px;
  color: #657080;
  font-size: 12px;
}
.nav-section button {
  color: inherit;
  padding: 3px;
}
.nav-section > button:first-child {
  padding-left: 0;
}
.nav-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.batch-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #5c9def;
  margin-left: auto;
  flex-shrink: 0;
}
.nav-empty {
  font-size: 12px;
  color: #657080;
  margin: 15px 12px;
  line-height: 1.7;
}
.nav-add {
  font-size: 12px;
  color: #737b88;
  margin: 5px 10px;
  padding: 6px 0;
}
.sidebar-bottom {
  margin-top: auto;
  padding-top: 40px;
}
.local-card {
  display: flex;
  gap: 10px;
  align-items: center;
  margin: 0 10px 22px;
  color: #6e7984;
}
.local-card > svg {
  color: #657080;
}
.local-card div {
  font-size: 12px;
}
.local-card small {
  display: block;
  font-size: 12px;
  margin-top: 5px;
  color: #657080;
}
.version {
  margin-left: auto;
  font-size: 12px;
  color: #657080;
}
.main-shell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
  overflow-x: clip;
}
.toolbar {
  min-height: 76px;
  border-bottom: 1px solid #f0f0f2;
  padding: 0 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #657080;
  font-size: 12px;
  white-space: nowrap;
}
.breadcrumb span {
  color: #545966;
}
.toolbar-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}
.search {
  display: flex;
  gap: 8px;
  align-items: center;
  color: #657080;
  padding: 8px 10px;
  border-radius: 7px;
  background: #f5f6f8;
  width: 240px;
  margin-right: 8px;
}
.search input {
  background: none;
  border: 0;
  min-width: 0;
  width: 100%;
  outline: none;
  font-size: 12px;
  color: #353944;
}
.search input::placeholder {
  color: #657080;
}
.search kbd {
  white-space: nowrap;
  font-family: inherit;
  font-size: 12px;
  color: #657080;
}
.primary,
.secondary,
.danger-button {
  border-radius: 7px;
  padding: 10px 15px;
  font-size: 12px;
  font-weight: 500;
  min-height: 36px;
  white-space: nowrap;
}
.primary {
  color: white;
  background: var(--blue);
  box-shadow:
    0 1px 2px #0b70d220,
    inset 0 1px 0 #ffffff24;
  border: 1px solid #0875e3;
}
.primary:hover:not(:disabled) {
  background: #006bdb;
}
.secondary {
  background: #fff;
  border: 1px solid #e1e3e8;
  box-shadow: 0 1px 2px #14182b04;
}
.secondary:hover:not(:disabled) {
  background: #f7f8fa;
  border-color: #c8cdd5;
}
.compact {
  font-size: 12px;
  min-height: 32px;
  padding: 7px 11px;
}
.icon-button {
  width: 30px;
  height: 30px;
  border-radius: 6px;
  color: #657080;
  flex-shrink: 0;
}
.icon-button:hover {
  background: #eff1f5;
  color: #3d4757;
}
.bordered {
  border: 1px solid #e1e3e8;
  width: 36px;
  height: 36px;
}
main {
  flex: 1;
  padding: 41px 38px 20px;
}
.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
}
.eyebrow {
  font-size: 12px;
  color: #657080;
  letter-spacing: 0.5px;
  margin: 0 0 9px;
}
.heading-context {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}
.heading-context .eyebrow {
  margin-bottom: 0;
}
h1 {
  font-size: 30px;
  line-height: 1.3;
  font-weight: 620;
  letter-spacing: -1px;
  margin: 0 0 12px;
}
.page-heading p:not(.eyebrow) {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #657080;
  font-size: 12px;
  margin: 0;
  line-height: 1.7;
  max-width: 650px;
  flex-wrap: wrap;
}
.heading-divider {
  height: 10px;
  width: 1px;
  background: #dde0e5;
  margin: 0 5px;
}
.heading-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 25px;
}
.heading-actions .secondary {
  font-size: 12px;
}
.tag {
  font-size: 12px;
  font-weight: 500;
  line-height: 1.5;
  border: 1px solid #e0e3e8;
  padding: 2px 6px;
  border-radius: 5px;
  color: #737984;
  white-space: nowrap;
}
.tag.blue {
  border-color: #d8e9fe;
  background: #f1f7ff;
  color: #2881da;
}
.tag.green {
  color: var(--green);
  background: #edf8f1;
  border-color: #dbede2;
}
.overview {
  border: 1px solid var(--line);
  border-radius: 11px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 23px 0;
  margin-bottom: 23px;
  box-shadow: 0 2px 4px #20253602;
}
.stat {
  padding: 0 25px;
  align-items: flex-start;
  flex-direction: column;
  border-right: 1px solid var(--line);
  gap: 16px;
  text-align: left;
  border-radius: 0;
  position: relative;
}
.stat:last-child {
  border: 0;
}
.stat:hover {
  background: #fafbfe;
}
.stat.chosen::after {
  content: "";
  position: absolute;
  left: 25px;
  bottom: -24px;
  width: 22px;
  height: 2px;
  border-radius: 1px;
  background: #4c9aef;
}
.stat-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #657080;
}
.stat strong {
  font-size: 32px;
  line-height: 1;
  font-weight: 550;
  letter-spacing: -1px;
}
.stat small {
  font-size: 12px;
  color: #657080;
  margin-left: 9px;
  font-weight: 400;
  letter-spacing: 0;
}
.neutral {
  color: #657080;
}
.orange {
  color: #cb8a32;
}
.purple {
  color: #9e7bc5;
}
.green {
  color: #4e9b7d;
}
.release-progress {
  display: flex;
  align-items: center;
  gap: 17px;
  font-size: 12px;
  color: #657080;
  padding: 0 2px 26px;
}
.release-progress > div:first-child {
  display: flex;
  gap: 14px;
  color: #727985;
  align-items: center;
}
.release-progress strong {
  color: #434b57;
  font-weight: 600;
  font-size: 12px;
}
.release-progress strong span {
  font-weight: 400;
  color: #657080;
}
.progress-track {
  height: 4px;
  border-radius: 5px;
  background: #eff1f4;
  flex: 1;
  max-width: 255px;
  overflow: hidden;
}
.progress-track span {
  height: 100%;
  background: #459e7c;
  display: block;
  border-radius: inherit;
  transition: width 0.25s;
}
.release-progress > .text-button {
  margin-left: auto;
  font-size: 12px;
  color: #657080;
}
.text-button {
  color: #1478dc;
  font-size: 12px;
  padding: 5px 0;
}
.text-button:hover {
  color: #0059b4;
}
.list-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15px;
  gap: 12px;
}
.tabs {
  display: flex;
  background: #f3f4f6;
  padding: 3px;
  border-radius: 7px;
  gap: 2px;
}
.tabs button {
  font-size: 12px;
  padding: 6px 13px;
  border-radius: 5px;
  color: #657080;
}
.tabs button.selected {
  background: white;
  box-shadow: 0 1px 4px #1e2b4114;
  color: #353c49;
  font-weight: 500;
}
.list-filters {
  display: flex;
  gap: 9px;
  align-items: center;
}
.filter-select {
  display: flex;
  gap: 5px;
  align-items: center;
  color: #657080;
  border: 1px solid #e6e8ed;
  border-radius: 6px;
  padding: 6px 9px;
}

.result-count {
  font-size: 12px;
  color: #657080;
  white-space: nowrap;
  margin-left: 5px;
}
.table-scroll {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 9px 9px 0 0;
}
table {
  border-collapse: collapse;
  width: 100%;
  text-align: left;
  white-space: nowrap;
}
thead {
  background: #fafbfc;
}
th {
  height: 42px;
  font-size: 12px;
  color: #657080;
  font-weight: 400;
  padding: 0 13px;
  border-bottom: 1px solid var(--line);
}
td {
  height: 86px;
  padding: 14px 13px;
  border-bottom: 1px solid #f0f1f4;
  font-size: 12px;
}
tr:last-child td {
  border-bottom: 0;
}
tbody tr:hover {
  background: #fcfcfd;
}
tbody tr.row-selected {
  background: #f2f7ff;
}
.select-cell {
  width: 37px;
  padding-left: 16px;
  padding-right: 0;
}
.select-cell input {
  width: 13px;
  height: 13px;
  opacity: 0.65;
  vertical-align: middle;
}
.branch-cell {
  min-width: 230px;
  max-width: 350px;
}
.branch-name {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #657080;
}
.branch-name > button:first-of-type {
  font-family: "SFMono-Regular", Consolas, monospace;
  color: #3b4555;
  font-size: 12px;
  padding: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
  text-align: left;
  max-width: 255px;
}
.branch-name > button:first-of-type:hover {
  color: var(--blue);
}
.branch-cell p {
  color: #657080;
  margin: 8px 0 0 21px;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 12px;
}
.copy-button {
  color: #657080;
  padding: 4px;
  border-radius: 4px;
}
.copy-button:hover {
  color: var(--blue);
  background: #e9f3ff;
}
.project-pill {
  background: #f7f8fa;
  border: 1px solid #e9ebef;
  padding: 4px 7px;
  border-radius: 5px;
  font-size: 12px;
  color: #737b88;
}
.project-pill span {
  width: 5px;
  height: 5px;
  border-radius: 2px;
}
.status {
  gap: 5px;
  color: #657080;
  font-size: 12px;
  padding: 6px 0;
}
.status.done {
  color: #28704e;
}
.status.done svg {
  fill: #ecf7f0;
}
.status:not(:disabled):hover {
  color: var(--blue);
}
.release-status {
  color: #657080;
}

.action-cell {
  width: 34px;
  padding-left: 3px;
  padding-right: 7px;
}
.action-cell .icon-button {
  width: 24px;
}
.add-row {
  width: 100%;
  padding: 15px 16px;
  font-size: 12px;
  justify-content: flex-start;
  color: #657080;
  border: 1px solid var(--line);
  border-top: none;
  border-radius: 0 0 9px 9px;
}
.add-row:hover {
  background: #f8fbff;
  color: var(--blue);
}
.add-row span {
  font-size: 12px;
  color: #657080;
  margin-left: auto;
}
.batch-destinations {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  color: #657080;
  font-size: 12px;
  margin: 22px 0 0;
  padding: 16px 0;
  border-bottom: 1px solid #f1f2f5;
}
.batch-destinations > svg {
  color: #657080;
}
.batch-destinations button {
  font-size: 12px;
  padding: 4px 6px;
  color: #657080;
}
.batch-destinations code {
  font-size: 12px;
  color: #747f90;
  background: #f5f6f8;
  padding: 3px 5px;
  border-radius: 3px;
}
.workspace-note {
  display: flex;
  gap: 7px;
  align-items: center;
  color: #657080;
  font-size: 12px;
  margin: 22px 0;
}
.app-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34px;
  border-top: 1px solid #eff0f3;
  padding: 0 28px;
  color: #657080;
  font-size: 12px;
}
.app-footer > span {
  display: flex;
  gap: 7px;
  align-items: center;
}
.save-dot {
  height: 5px;
  width: 5px;
  background: #61a785;
  border-radius: 50%;
}
.save-dot.saving {
  background: #d89e39;
}
.footer-divider {
  height: 9px;
  width: 1px;
  background: #dfe1e6;
  margin: 0 5px;
}
.empty-state {
  text-align: center;
  min-height: 330px;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 62px 20px;
}
.empty-icon {
  background: #f2f6fc;
  color: #6496d2;
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  margin: 0 auto 23px;
  border-radius: 19px;
}
.empty-state h2 {
  font-size: 20px;
  font-weight: 550;
  letter-spacing: -0.3px;
  margin: 0 0 12px;
}
.empty-state p {
  font-size: 12px;
  color: #657080;
  margin-bottom: 23px;
  line-height: 1.7;
}
.empty-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
}
.selection-bar {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 10px 13px;
  background: #eef6ff;
  border-radius: 7px;
  font-size: 12px;
  color: #3982c7;
  margin-bottom: 12px;
}
.selection-bar .icon-button {
  margin-left: auto;
}
.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
}
.project-card {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 23px;
  min-height: 205px;
}
.project-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.project-card h2 {
  font-size: 16px;
  font-weight: 550;
  margin: 0 0 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.project-card p {
  font-size: 12px;
  color: #657080;
  margin: 0 0 20px;
  line-height: 1.7;
}
.project-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #f0f1f4;
  padding-top: 10px;
}
.project-card.archived {
  background: #fafafa;
}
.add-project {
  border-style: dashed;
  color: #657080;
  gap: 15px;
  flex-direction: column;
  font-size: 12px;
}
.add-project:hover {
  color: var(--blue);
  background: #f8fbff;
}
.settings-panel {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 25px 28px;
  margin-bottom: 22px;
  max-width: 950px;
}
.settings-panel h2 {
  font-size: 16px;
  font-weight: 550;
  margin: 0 0 8px;
}
.setting-row {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
  padding: 23px 0;
  border-bottom: 1px solid var(--line);
}
.setting-row:last-child {
  border: 0;
  padding-bottom: 3px;
}
.setting-row h3 {
  font-size: 12px;
  font-weight: 500;
  margin: 0 0 9px;
}
.setting-row p,
.settings-copy {
  font-size: 12px;
  color: #657080;
  line-height: 1.8;
  margin: 0;
}
.settings-copy {
  margin-top: 13px;
}
.modal {
  padding: 0;
  width: min(520px, calc(100vw - 32px));
  max-height: calc(100dvh - 64px);
  border: 1px solid #dfe3e8;
  border-radius: 16px;
  box-shadow: 0 24px 100px #172b453b;
  color: #303642;
  background: #fff;
}
.modal.wide {
  width: min(1000px, calc(100vw - 32px));
}
.modal::backdrop {
  background: #1c283449;
  backdrop-filter: blur(5px);
}
.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 27px 17px;
  border-bottom: 1px solid #eff0f3;
}
.modal-head h2 {
  margin: 0;
  font-size: 18px;
  letter-spacing: -0.4px;
  font-weight: 550;
}
.form,
.confirm-body,
.import-body {
  padding: 24px 27px;
}
.form {
  display: flex;
  flex-direction: column;
  gap: 19px;
}
.form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  color: #626c7b;
}
.form input:not([type="radio"]),
.form textarea,
.import-row input:not([type="checkbox"]) {
  display: block;
  width: 100%;
  border: 1px solid #dfe3e9;
  border-radius: 7px;
  padding: 10px 11px;
  background: #fff;
  color: #394353;
  font-size: 12px;
  min-height: 39px;
}
.form input::placeholder,
.form textarea::placeholder,
.import-row input::placeholder {
  color: #657080;
}
.form textarea {
  resize: vertical;
}
.form .optional {
  color: #657080;
  font-size: 12px;
}
.modal-actions {
  display: flex;
  gap: 9px;
  align-items: center;
  justify-content: flex-end;
  margin-top: 9px;
}
.spacer {
  flex: 1;
}
.danger {
  color: #c65252;
  font-size: 12px;
}
.danger-button {
  color: white;
  background: #db4848;
  border: 1px solid #ca3838;
}
.form-error,
.error-banner {
  color: #ac3939;
  background: #fff1f1;
  padding: 11px 13px;
  border-radius: 7px;
  font-size: 12px;
  line-height: 1.7;
  margin: 0;
}
.error-banner {
  display: flex;
  gap: 20px;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.error-banner button {
  color: #9f3535;
  white-space: nowrap;
}
.field-hint {
  font-size: 12px;
  color: #657080;
  line-height: 1.7;
  margin: 0;
}
.target-fields {
  border-top: 1px solid var(--line);
  padding-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 13px;
}
.target-fields h3 {
  font-size: 12px;
  font-weight: 550;
  margin: 0;
}
.color-picker {
  border: 0;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 12px;
}
.color-picker legend {
  font-size: 12px;
  color: #626c7b;
  margin-bottom: 13px;
}
.color-picker label {
  position: relative;
  width: 27px;
  height: 27px;
  cursor: pointer;
}
.color-picker input {
  position: absolute;
  opacity: 0;
  width: 100%;
  height: 100%;
  margin: 0;
}
.color-picker span {
  width: 27px;
  height: 27px;
  border: 3px solid white;
  border-radius: 50%;
  background: var(--project-color);
}
.color-picker input:checked + span {
  outline: 2px solid var(--project-color);
}
.color-picker input:focus-visible + span {
  outline: 3px solid #9cc5ff;
  outline-offset: 3px;
}
.confirm-body > p {
  font-size: 12px;
  line-height: 1.9;
  color: #657080;
  margin: 0 0 18px;
  overflow-wrap: anywhere;
}
.confirm-body strong {
  color: #3d4757;
}
.confirm-body .modal-actions {
  margin-top: 25px;
}
.release-review {
  max-height: 330px;
  overflow-y: auto;
  background: #f7f8fa;
  border-radius: 9px;
  padding: 4px 16px;
}
.release-review > div {
  padding: 15px 0;
  border-bottom: 1px solid #e5e8ef;
}
.release-review > div:last-child {
  border: 0;
}
.release-review span {
  font-size: 12px;
  color: #657080;
  display: block;
  margin-bottom: 6px;
}
.release-review strong {
  font-family: Consolas, monospace;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.release-review p {
  font-size: 12px;
  color: #657080;
  margin: 7px 0;
}
.warning {
  color: #a97525;
  font-size: 12px;
  line-height: 1.7;
}
.warning-panel {
  background: #fff8e9;
  padding: 14px;
  font-size: 12px;
  color: #9c792f;
  border-radius: 8px;
  line-height: 1.8;
}
.import-body > p {
  font-size: 12px;
  color: #657080;
  line-height: 1.8;
  margin: 0 0 17px;
}
.import-rows {
  max-height: 50dvh;
  overflow: auto;
  padding: 4px;
}
.import-row {
  display: grid;
  grid-template-columns: 18px 1fr 1.5fr 1.5fr 1.4fr;
  align-items: center;
  gap: 9px;
  margin-bottom: 10px;
  min-width: 650px;
}
.import-body .form-error {
  margin-top: 15px;
}
.toast {
  position: fixed;
  bottom: 32px;
  left: calc(50% + 90px);
  transform: translateX(-50%);
  max-width: calc(100vw - 40px);
  background: #253242;
  color: #fff;
  padding: 13px 19px;
  border-radius: 11px;
  box-shadow: 0 6px 25px #202d4126;
  display: flex;
  gap: 9px;
  align-items: center;
  font-size: 12px;
  z-index: 20;
  animation: toast-in 0.18s ease-out;
}
.toast svg {
  color: #657080;
}
.loading {
  height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5a92c8;
  font-size: 14px;
}
.sr-only,
.skip-link:not(:focus) {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
.skip-link:focus {
  position: fixed;
  top: 10px;
  left: 10px;
  z-index: 50;
  padding: 10px;
  background: white;
  color: var(--blue);
}
@keyframes toast-in {
  from {
    opacity: 0;
    margin-bottom: -5px;
  }
  to {
    opacity: 1;
    margin-bottom: 0;
  }
}
@media (min-width: 1600px) {
  main {
    padding: 50px 56px 25px;
  }
  .toolbar {
    padding: 0 56px;
  }
  .branch-cell {
    width: 30%;
  }
  td {
    height: 92px;
  }
}
@media (max-width: 1200px) {
  .sidebar {
    width: 205px;
    padding-left: 12px;
    padding-right: 12px;
  }
  .brand {
    padding-left: 7px;
  }
  .brand > span {
    font-size: 18px;
  }
  main {
    padding: 30px 25px 15px;
  }
  .toolbar {
    padding: 0 25px;
  }
  .breadcrumb {
    display: none;
  }
  .toolbar-actions {
    width: 100%;
  }
  .search {
    margin-right: auto;
    flex: 1;
    max-width: 340px;
  }
  .stat {
    padding: 0 18px;
  }
  .stat-label {
    font-size: 12px;
    gap: 6px;
  }
  .stat.chosen::after {
    left: 18px;
  }
  .heading-actions {
    padding-top: 0;
  }
  .page-heading p {
    max-width: 420px;
  }
}
@media (max-width: 900px) {
  .sidebar {
    width: 178px;
    padding: 25px 9px 12px;
  }
  .brand {
    gap: 7px;
  }
  .brand-icon {
    width: 31px;
    height: 34px;
    border-radius: 10px;
  }
  .brand > span {
    font-size: 16px;
  }
  .brand small {
    font-size: 12px;
    letter-spacing: 0;
  }
  .local-card {
    gap: 7px;
    margin-left: 6px;
  }
  .local-card small {
    font-size: 12px;
  }
  .local-card div {
    font-size: 12px;
  }
  .nav-item {
    padding-left: 9px;
    font-size: 12px;
  }
  .toolbar {
    padding: 0 20px;
  }
  .search kbd {
    display: none;
  }
  .page-heading {
    align-items: flex-start;
  }
  h1 {
    font-size: 26px;
  }
  .page-heading p:not(.eyebrow) {
    font-size: 12px;
  }
  .stat {
    padding: 0 13px;
  }
  .stat-label {
    font-size: 12px;
    gap: 4px;
  }
  .stat-label svg {
    width: 13px;
  }
  .stat strong {
    font-size: 28px;
  }
  .stat small {
    font-size: 12px;
    margin-left: 5px;
  }
  .overview {
    padding: 20px 0;
  }
  .stat.chosen::after {
    bottom: -21px;
    left: 13px;
  }
  .list-toolbar {
    flex-wrap: wrap;
  }
  .result-count {
    margin-left: auto;
  }
  .list-filters {
    flex: 1;
  }
  .heading-actions .secondary {
    padding: 9px;
  }
  .heading-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .heading-divider {
    display: none;
  }
}
@media (max-width: 650px) {
  .app-shell {
    flex-direction: column;
  }
  .sidebar {
    width: 100%;
    height: auto;
    position: static;
    padding: 18px 16px;
    border-right: none;
    border-bottom: 1px solid #e3e6eb;
  }
  .brand {
    padding: 0 0 16px;
  }
  .brand > span {
    font-size: 20px;
  }
  .brand small {
    font-size: 12px;
  }
  .sidebar nav {
    display: flex;
    overflow-x: auto;
    gap: 5px;
  }
  .nav-item {
    width: auto;
    white-space: nowrap;
    margin: 0;
    font-size: 12px;
    flex-shrink: 0;
    gap: 7px;
  }
  .nav-section,
  .workspace-label,
  .nav-empty,
  .sidebar-bottom,
  .nav-add {
    display: none;
  }
  .count {
    margin-left: 4px;
  }
  .toolbar {
    min-height: 64px;
    padding: 12px 16px;
  }
  .toolbar-actions {
    gap: 7px;
  }
  .search {
    width: 110px;
    margin: 0;
    padding: 8px;
  }
  .search input {
    font-size: 12px;
  }
  .toolbar .secondary {
    display: none;
  }
  .toolbar .primary {
    font-size: 12px;
  }
  main {
    padding: 27px 17px 15px;
  }
  .page-heading {
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }
  .page-heading p:not(.eyebrow) {
    font-size: 12px;
  }
  .heading-actions {
    justify-content: flex-start;
  }
  .overview {
    grid-template-columns: 1fr 1fr;
    row-gap: 26px;
    padding: 21px 0;
  }
  .stat {
    padding-left: 19px;
    gap: 12px;
  }
  .stat:nth-child(2) {
    border: 0;
  }
  .stat-label {
    font-size: 12px;
    gap: 7px;
  }
  .stat.chosen::after {
    display: none;
  }
  .stat.chosen .stat-label {
    color: var(--blue);
  }
  .stat strong {
    font-size: 30px;
  }
  .stat small {
    font-size: 12px;
  }
  .release-progress {
    gap: 10px;
    flex-wrap: wrap;
  }
  .progress-track {
    min-width: 60px;
  }
  .release-progress > .text-button {
    font-size: 12px;
  }
  .list-toolbar {
    gap: 15px;
  }
  .tabs button {
    font-size: 12px;
  }
  .table-scroll {
    margin-right: -17px;
    border-radius: 8px 0 0;
  }
  td {
    height: 80px;
  }
  .batch-destinations {
    gap: 7px;
  }
  .batch-destinations > span {
    width: calc(100% - 30px);
  }
  .app-footer {
    padding: 0 16px;
    font-size: 12px;
  }
  .workspace-note {
    line-height: 1.7;
  }
  .empty-state {
    padding: 45px 15px;
  }
  .empty-state h2 {
    font-size: 18px;
  }
  .empty-actions {
    flex-direction: column;
    gap: 10px;
  }
  .toast {
    left: 50%;
    bottom: 25px;
    width: max-content;
  }
  .modal {
    max-height: calc(100dvh - 32px);
  }
  .modal-head {
    padding: 18px 20px;
  }
  .form,
  .confirm-body,
  .import-body {
    padding: 21px 20px;
  }
  .form input:not([type="radio"]),
  .form textarea {
    font-size: 16px;
  }
  .setting-row {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }
  .settings-panel {
    padding: 22px;
  }
  .selection-bar {
    gap: 12px;
  }
  .error-banner {
    flex-wrap: wrap;
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}

.custom-select {
  display: inline-flex;
  min-width: 0;
  max-width: 100%;
}
.select-trigger {
  width: 100%;
  min-width: 0;
  gap: 10px;
  justify-content: space-between;
  border: 1px solid #dde2e9;
  border-radius: 7px;
  padding: 8px 10px;
  color: #3b4655;
  background: white;
  min-height: 34px;
  text-align: left;
  font-size: 12px;
}
.select-trigger > span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.select-trigger > svg {
  color: #657080;
}
.select-trigger:hover:not(:disabled),
.select-trigger[aria-expanded="true"] {
  background: #f5f8fd;
  border-color: #90baf0;
}
.select-menu {
  position: fixed;
  inset: auto;
  margin: 0;
  border: 1px solid #dbe1ea;
  padding: 5px;
  border-radius: 10px;
  background: #fff;
  color: #253244;
  box-shadow:
    0 8px 30px #1f344522,
    0 2px 5px #1f344514;
  overflow-y: auto;
  overscroll-behavior: contain;
  font-size: 14px;
}
.select-menu:popover-open {
  display: flex;
  flex-direction: column;
}
.select-menu > button {
  justify-content: space-between;
  gap: 16px;
  flex-shrink: 0;
  padding: 9px 10px;
  min-height: 38px;
  border-radius: 5px;
  font-size: 14px;
  text-align: left;
  overflow-wrap: anywhere;
}
.select-menu > button:hover,
.select-menu > button:focus {
  outline: none;
  background: #edf4fe;
  color: #0866cb;
}
.select-menu > button[aria-selected="true"] {
  color: #0866cb;
  background: #f2f7ff;
}
.filter-select {
  padding: 0 0 0 10px;
  gap: 2px;
}
.filter-select .select-trigger {
  border: none;
  background: transparent;
  min-height: 34px;
}
.form .custom-select {
  width: 100%;
}
.form .select-trigger {
  min-height: 42px;
  font-size: 14px;
  padding: 10px 11px;
}
.batch-select .select-trigger {
  max-width: 165px;
  background: #f8f9fb;
}
.nav-item,
.branch-name > button:first-of-type,
.branch-cell p,
.primary,
.secondary,
.form input:not([type="radio"]),
.form textarea,
.status {
  font-size: 14px;
}
.compact,
.heading-actions .secondary {
  font-size: 12px;
}
.stat-label {
  font-size: 12px;
}
.branch-cell {
  min-width: 300px;
}
.branch-name > button:first-of-type {
  max-width: 310px;
}
td {
  padding-left: 14px;
  padding-right: 14px;
}
.status {
  font-size: 12px;
  min-height: 36px;
}
.sidebar {
  width: 248px;
}
.icon-button {
  min-width: 30px;
  min-height: 30px;
}
.field-label {
  font-size: 14px;
  color: #526074;
}
.repository-picker {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.repository-path {
  display: flex;
  align-items: center;
  gap: 12px;
}
.repository-path > span {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #657080;
  overflow-wrap: anywhere;
}
.repository-body {
  padding: 24px 28px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  font-size: 14px;
}
.repository-top {
  display: flex;
  gap: 14px;
  align-items: flex-end;
  flex-wrap: wrap;
}
.repository-top > label,
.merge-fields > label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  color: #526074;
  min-width: 170px;
}
.repository-top .select-trigger {
  font-size: 14px;
  min-height: 38px;
}
.repository-location {
  flex: 1;
  min-width: 160px;
  display: flex;
  flex-direction: column;
  gap: 9px;
}
.repository-location > span {
  font-size: 12px;
  color: #657080;
}
.repository-location strong {
  font-size: 14px;
  font-weight: 500;
  overflow-wrap: anywhere;
  min-height: 38px;
  display: flex;
  align-items: center;
}
.repository-controls {
  display: flex;
  gap: 20px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}
.repository-search,
.merge-fields input {
  min-height: 38px;
  border: 1px solid #dde2e9;
  border-radius: 7px;
  padding: 9px 11px;
  background: white;
  color: #303f52;
  font-size: 14px;
  min-width: 0;
}
.repository-branches {
  max-height: 350px;
  overflow-y: auto;
  border: 1px solid #e5e9ef;
  border-radius: 9px;
}
.repository-branch {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 16px;
  border-bottom: 1px solid #e9edf2;
}
.repository-branch:last-child {
  border-bottom: none;
}
.repository-branch > input {
  margin-top: 4px;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
}
.repository-branch > div {
  min-width: 0;
  flex: 1;
}
.repository-branch-name {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  color: #526074;
}
.repository-branch-name code {
  font-size: 14px;
  color: #27374c;
  overflow-wrap: anywhere;
}
.repository-branch input:not([type="checkbox"]) {
  width: 100%;
  margin-top: 10px;
  border: 1px solid #e3e7ee;
  border-radius: 6px;
  padding: 8px 10px;
  font-size: 14px;
  color: #435268;
  background: white;
}
.repository-branch p {
  font-size: 14px;
  color: #657080;
  margin: 10px 0 0;
}
.repository-commit {
  font-size: 12px;
  color: #657080;
  padding-top: 3px;
}
.repository-empty {
  text-align: center;
  padding: 48px 25px;
  color: #657080;
  line-height: 1.8;
}
.repository-loading {
  color: #236fbe;
  font-size: 14px;
  margin: 0;
}
.merge-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding: 18px;
  border-radius: 10px;
  background: #f5f8fc;
}
.merge-fields p {
  grid-column: 1/-1;
  margin: 0;
  font-size: 12px;
  line-height: 1.8;
  color: #657080;
}
.merge-fields .select-trigger {
  font-size: 14px;
  min-height: 40px;
}
.merge-preview,
.merge-result {
  line-height: 1.8;
}
.merge-preview h3,
.merge-result h3 {
  font-size: 18px;
  margin: 0 0 14px;
}
.merge-result h4 {
  font-size: 14px;
  margin: 12px 0 5px;
}
.merge-preview li {
  padding: 6px 0;
}
.merge-preview li span {
  color: #657080;
  font-size: 12px;
  margin-left: 15px;
}
.merge-preview code,
.merge-result code {
  overflow-wrap: anywhere;
}
.merge-preview .warning-panel,
.merge-result .warning-panel {
  font-size: 14px;
}
.merge-result pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background: #f3f5f8;
  border-radius: 8px;
  padding: 15px;
  max-height: 220px;
  overflow-y: auto;
  font-size: 12px;
}
.merge-result summary {
  cursor: pointer;
  color: #196bc2;
}
@media (max-width: 1200px) {
  .toolbar {
    flex-wrap: wrap;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .search {
    min-width: 160px;
  }
  .sidebar {
    width: 210px;
  }
  .list-toolbar {
    flex-wrap: wrap;
  }
}
@media (max-width: 900px) {
  .sidebar {
    width: 185px;
  }
  .toolbar-actions {
    flex-wrap: wrap;
  }
  .search {
    max-width: none;
  }
  .overview {
    grid-template-columns: 1fr 1fr;
    row-gap: 24px;
  }
  .stat:nth-child(2) {
    border-right: 0;
  }
  .stat.chosen::after {
    display: none;
  }
  .stat.chosen .stat-label {
    color: #0866cb;
  }
}
@media (max-width: 650px) {
  .sidebar {
    width: 100%;
  }
  .nav-item {
    font-size: 12px;
  }
  .toolbar .repository-entry {
    display: inline-flex;
  }
  .search {
    flex-basis: 100%;
  }
  .toolbar-actions {
    justify-content: flex-end;
  }
  .repository-body {
    padding: 20px;
  }
  .merge-fields {
    grid-template-columns: 1fr;
  }
  .repository-commit {
    display: none;
  }
  .repository-body .modal-actions {
    flex-wrap: wrap;
  }
  .list-filters {
    flex-wrap: wrap;
  }
  .stat-label {
    font-size: 12px;
  }
  .repository-top > label {
    width: 100%;
  }
  .form .select-trigger {
    font-size: 16px;
  }
}
